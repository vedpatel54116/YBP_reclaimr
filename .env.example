# ─────────────────────────────────────────────────────────────────────────────
# ReclaimR environment variables
#
# Copy to `.env` at the repo root for the API (loaded automatically on `dev`
# and `start`). Next.js only reads env files from `apps/web`, so put web
# variables in `apps/web/.env.local` (see apps/web/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── apps/api ────────────────────────────────────────────────────────────────
API_PORT=3001
# Comma-separated list of origins allowed to call the API (empty = allow all).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL — matches docker-compose.yml.
DATABASE_URL=postgresql://reclaimr:reclaimr@localhost:5432/reclaimr

# Redis (optional for the API). Uncomment to enable Redis-backed rate limiting
# and BullMQ background jobs (sync/detection/alerts run on apps/worker).
# Without Redis, sync + detection still work — they run inline in the request.
# Note: with REDIS_URL set, the API fails closed while Redis is unreachable.
# REDIS_URL=redis://localhost:6379

# JWT access-token signing secret. MUST be replaced in any real environment.
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=dev-only-secret-please-generate-a-real-one-with-openssl-rand
# Access token lifetime (seconds) and refresh token lifetime (days).
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Staff console (admin realm) ─────────────────────────────────────────────
# Separate signing secret for staff tokens, so a member token can never be
# replayed as a staff token and rotating one realm does not sign out the other.
# Optional in development (derived from JWT_ACCESS_SECRET); REQUIRED in production.
# Generate with: openssl rand -base64 32
# JWT_ADMIN_SECRET=
# Staff sessions are deliberately short; staff re-authenticate rather than refresh.
JWT_ADMIN_TTL_SECONDS=900
# Require TOTP on every staff account. Always enforced in production regardless
# of this value; set true locally to rehearse the production login flow.
ADMIN_MFA_REQUIRED=false

# ── Stripe (premium billing) ────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY unset to use the deterministic mock billing adapter
# (no keys, no network — premium can be exercised end to end locally). The API
# refuses to start in production without a real key rather than granting
# premium for free.
#
# The webhook is what actually grants premium, so STRIPE_WEBHOOK_SECRET is
# mandatory in production whenever STRIPE_SECRET_KEY is set. Get one with:
#   stripe listen --forward-to localhost:3001/api/v1/billing/webhook
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe Checkout returns the member.
STRIPE_SUCCESS_URL=http://localhost:3000/settings/premium?status=ok
STRIPE_CANCEL_URL=http://localhost:3000/settings/premium?status=canceled

# ── Negotiation statement storage ───────────────────────────────────────────
# Where uploaded bill statements are written. Must be a durable volume in
# production; multi-replica deployments need an object-storage adapter instead
# (see apps/api/src/adapters/storage/index.ts).
STATEMENT_STORAGE_DIR=./.data/statements

# ── Plaid (optional) ────────────────────────────────────────────────────────
# Leave PLAID_CLIENT_ID/PLAID_SECRET unset to use the deterministic mock
# aggregator (no keys, no network — generates realistic history for local
# dev and tests). Set both to use real Plaid; PLAID_ENV=sandbox works with
# free developer keys.
PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=

# AES key for encrypting aggregator access tokens at rest. Optional in
# development (falls back to the JWT secret); required in production.
# Generate with: openssl rand -base64 32
# BANK_TOKEN_ENCRYPTION_KEY=

# ── LLM (optional) ──────────────────────────────────────────────────────────
# Powers AI features (alternative advisor). Leave LLM_API_KEY unset to use the
# deterministic mock adapter — no keys, no network, works offline and in CI.
# Any OpenAI-compatible /chat/completions endpoint works (OpenAI, OpenRouter,
# a local model server); only the base URL changes.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=30000

# ── apps/worker ─────────────────────────────────────────────────────────────
# Required for the worker (BullMQ has no inline fallback).
# REDIS_URL=redis://localhost:6379
# Which queues this replica consumes (comma-separated, or "all").
# Queues: plaid.sync, detection.subscriptions, detection.bills,
#         alerts.evaluate, maintenance, ai.generate
# WORKER_QUEUES=all

# ── apps/web (put these in apps/web/.env.local) ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
