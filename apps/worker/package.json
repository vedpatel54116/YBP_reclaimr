{
  "name": "@reclaimr/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "postinstall": "prisma generate --schema ../api/prisma/schema.prisma",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@reclaimr/api": "workspace:*",
    "@reclaimr/core": "workspace:*",
    "@reclaimr/queue": "workspace:*",
    "@reclaimr/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.0",
    "prisma": "^6.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
